datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String           @id @default(uuid())
  name               String
  role               String           // "officer" | "admin"
  email              String           @unique
  onboardingComplete Boolean          @default(false)
  profile            Profile?
  selfAssessments    SelfAssessment[]
  quizResults        QuizResult[]
  courseProgress     CourseProgress[]
  createdAt          DateTime         @default(now())
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  designation   String
  department    String
  jobRole       String
  experience    Int
  education     String?  // e.g. M.Sc Statistics (ISI), B.Tech Data Science
  pastTrainings String?  // e.g. iGOT Python, NSSTA Sampling Methodology
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Skill {
  id          String            @id @default(uuid())
  name        String
  domain      String            // "Statistical" | "Technical" | "Digital Governance" | "Behavioural"
  description String?
  assessments SelfAssessment[]
  quizResults QuizResult[]
  roleReqs    RoleRequirement[]
}

model SelfAssessment {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  rating    Int      // 1-5 self rating
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model QuizResult {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  score     Float    // 1-5 diagnostic test score
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Course {
  id             String           @id @default(uuid())
  title          String
  description    String?
  source         String           // "igot" | "nssta"
  skillTags      String           // JSON string of skill IDs
  duration       String
  url            String?
  provider       String?
  courseProgress CourseProgress[]
}

model CourseProgress {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  status      String    // "recommended" | "in_progress" | "completed"
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model RoleRequirement {
  id            String @id @default(uuid())
  jobRole       String
  skillId       String
  requiredLevel Float  // 1.0 - 5.0 benchmark score
  skill         Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model GeneratedQuiz {
  id        String   @id @default(uuid())
  createdBy String
  title     String?
  content   String   // JSON string storing array of questions
  createdAt DateTime @default(now())
}
